PORT=4000
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler

# Firebase Admin (Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the \n escapes as a single line, or wrap the real key in quotes with real newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Comma-separated Google emails that become approved admins on first login
ADMIN_EMAILS=you@gmail.com
